# SetuAI — environment variables
# Copy to .env and fill in for local dev. Never commit .env (see .gitignore).
# Only variables the CURRENT scaffolding actually reads are listed here.
# LLM/embeddings API keys, S3-style storage config etc. are added when the
# slice that needs them lands (extraction = Slice 3, matching = Slice 4) —
# see docs/ROADMAP.md.

# --- Backend (backend/config/settings.py) ---

# Local Postgres connection string. Default below matches a plain local
# Postgres install (see PostgreSQL section in the scaffolding report).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/setuai

APP_ENV=development
BACKEND_PORT=8000

# Origin the backend's CORS middleware allows in dev — must match where the
# frontend actually runs.
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend (frontend/services/apiClient.ts) ---
# Next.js only exposes NEXT_PUBLIC_* vars to the browser.

NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM Provider (backend/config/settings.py) — Slice 3, extraction ---
# Groq is the PRIMARY provider; Gemini is the AUTOMATIC FALLBACK, used only
# when Groq fails for an availability reason (rate limit, quota, connection
# failure, temporary server error) — not merely because output looked wrong.
# At least one of GROQ_API_KEY / GEMINI_API_KEY must be set for
# POST /projects/{id}/extract to work; without either, it returns a clear 503
# LLM_PROVIDER_NOT_CONFIGURED rather than faking a result.

GROQ_API_KEY=
# Optional — override the default extraction model. Strict structured-output
# mode currently requires openai/gpt-oss-20b or openai/gpt-oss-120b on Groq.
# GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
# Optional — override the default fallback model.
# GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings (backend/config/settings.py) — Slice 4, semantic matching ---
# Semantic retrieval (POST /events/{id}/match) always uses Gemini specifically
# — Groq has no embeddings API — reusing GEMINI_API_KEY above. Matching still
# needs GEMINI_API_KEY set even if you're running extraction on Groq alone.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
